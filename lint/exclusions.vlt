`verilator_config

// The MiSTer framework (sys/) is parsed for the interfaces the top level
// instantiates and not linted: not ours to change.
lint_off -file "sys/*"
lint_off -file "*/sys/*"
lint_off -rule PROCASSWIRE -file "sys/*"
lint_off -rule PROCASSWIRE -file "*/sys/*"
lint_off -file "lint/*"
lint_off -file "*/lint/*"

// Style diagnostics MiSTer's naming and FPGA power-up values don't follow.
lint_off -rule DECLFILENAME
lint_off -rule PINCONNECTEMPTY
lint_off -rule PROCASSINIT
lint_off -rule SIMILARNAME
lint_off -rule VARHIDDEN

// Patterns this RTL uses on purpose.  BLKSEQ: the SCSI engine's clocked block
// uses blocking temporaries.  MULTIDRIVEN: processor and MMU registers written
// from two always_ff blocks on the one clock (Verilator's note is about its
// own scheduling).  UNUSEDSIGNAL/UNUSEDPARAM: leftovers to prune, not faults.
lint_off -rule BLKSEQ -file "rtl/xl/xl_scsi.sv"
lint_off -rule BLKSEQ -file "*/rtl/xl/xl_scsi.sv"
lint_off -rule MULTIDRIVEN -file "rtl/ivory/*"
lint_off -rule MULTIDRIVEN -file "*/rtl/ivory/*"
lint_off -rule MULTIDRIVEN -file "rtl/xl/xl_i82586.sv"
lint_off -rule MULTIDRIVEN -file "*/rtl/xl/xl_i82586.sv"
lint_off -rule MULTIDRIVEN -file "rtl/xl/xl_fpa_unit.sv"
lint_off -rule MULTIDRIVEN -file "*/rtl/xl/xl_fpa_unit.sv"
lint_off -rule UNUSEDSIGNAL
lint_off -rule UNUSEDPARAM

// Framework ports the top level leaves unconnected, each by name so a
// connection dropped by mistake still shows as PINMISSING.
lint_off -rule PINMISSING -file "XL1200.sv" -match "*Instance has missing pin: 'direct_video'"
lint_off -rule PINMISSING -file "*/XL1200.sv" -match "*Instance has missing pin: 'direct_video'"
lint_off -rule PINMISSING -file "XL1200.sv" -match "*Instance has missing pin: 'ioctl_addr'"
lint_off -rule PINMISSING -file "*/XL1200.sv" -match "*Instance has missing pin: 'ioctl_addr'"
lint_off -rule PINMISSING -file "XL1200.sv" -match "*Instance has missing pin: 'ioctl_din'"
