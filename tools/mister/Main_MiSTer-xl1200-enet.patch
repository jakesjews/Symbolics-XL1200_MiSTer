From 225a18d9ef23babd63b7725239955ce9f1edc3cb Mon Sep 17 00:00:00 2001
From: Jacob Jewell <jakesjews@gmail.com>
Date: Wed, 4 Nov 2026 00:01:29 -0500
Subject: [PATCH] XL1200: Ethernet bridge (the 82586 in the FPGA, Main as the
 wire)

---
 support.h                 |   1 +
 support/xl1200/xl1200.cpp | 197 ++++++++++++++++++++++++++++++++++++++
 support/xl1200/xl1200.h   |   9 ++
 user_io.cpp               |   3 +
 4 files changed, 210 insertions(+)
 create mode 100644 support/xl1200/xl1200.cpp
 create mode 100644 support/xl1200/xl1200.h

diff --git a/support.h b/support.h
index c8b3b47..4ff8d95 100644
--- a/support.h
+++ b/support.h
@@ -31,6 +31,7 @@
 #include "support/hp9k/hp9k_enet.h"
 #include "support/sgi/sgi.h"
 #include "support/sgi/sgi_enet.h"
+#include "support/xl1200/xl1200.h"
 
 // Archie support
 #include "support/archie/archie.h"
diff --git a/support/xl1200/xl1200.cpp b/support/xl1200/xl1200.cpp
new file mode 100644
index 0000000..26b70bc
--- /dev/null
+++ b/support/xl1200/xl1200.cpp
@@ -0,0 +1,197 @@
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#include <stdint.h>
+
+#include "../../user_io.h"
+#include "../../shmem.h"
+#include "../minimig/minimig_a2065.h"
+#include "xl1200.h"
+
+extern int  ethernet_open(const char *iface, int promiscuous);
+extern void ethernet_close(void);
+extern void ethernet_send(const uint8_t *frame, int len);
+extern int  ethernet_recv_nb(uint8_t *buf, int maxlen);
+extern int  ethernet_set_mac_filter(const uint8_t *mac);
+extern int  ethernet_macvlan_create(const char *parent, const char *name, const uint8_t *mac);
+extern void ethernet_macvlan_delete(const char *name);
+extern void ethernet_offload_off(const char *iface);
+extern void ethernet_offload_on(const char *iface);
+extern uint32_t crc32_compute(const uint8_t *data, int len);
+
+#define SB_BASE    0x1FF00000UL
+#define SB_SIZE    0x10000UL
+#define SB_MAGIC   0x0000
+#define SB_GEN     0x0008
+#define SB_TXW     0x0010
+#define SB_TXR     0x0018
+#define SB_RXW     0x0020
+#define SB_RXR     0x0028
+#define SB_MAC     0x0030
+#define SB_TX      0x1000
+#define SB_RX      0x5000
+#define SB_SLOT    0x800
+#define TX_RING    8
+#define RX_RING    16
+#define MAX_FRAME  (SB_SLOT - 8)
+#define XL_MAGIC   0x584C455448303031ULL
+
+static volatile uint8_t *mb = 0;
+static int running = 0;
+static int link_open = 0;
+static int cur_mode = A2065_OFF;
+static int made_macvlan = 0;
+static const char *offload_iface = 0;
+static uint64_t gen = ~0ULL;
+static uint8_t guest_mac[6];
+static int mac_known = 0;
+static uint8_t frame[MAX_FRAME];
+
+static uint64_t rd64(uint32_t off) { return *(volatile uint64_t *)(mb + off); }
+static void wr64(uint32_t off, uint64_t v) { *(volatile uint64_t *)(mb + off) = v; }
+
+char is_xl1200()
+{
+	return !strncasecmp(user_io_get_core_name(0), "XL1200", 6) || !strncasecmp(user_io_get_core_name(1), "XL1200", 6);
+}
+
+static void close_link()
+{
+	if (link_open) ethernet_close();
+	if (made_macvlan) ethernet_macvlan_delete("xl0");
+	if (offload_iface) ethernet_offload_on(offload_iface);
+	link_open = 0;
+	made_macvlan = 0;
+	offload_iface = 0;
+}
+
+static void open_link(int mode)
+{
+	int wired = (mode == A2065_ETH0 || mode == A2065_ETH1);
+	const char *iface = (mode == A2065_ETH1) ? "eth1" : (mode == A2065_TAP) ? "tap0" : "eth0";
+
+	close_link();
+	if (mode == A2065_MACVLAN)
+	{
+		if (!mac_known || !ethernet_macvlan_create("eth0", "xl0", guest_mac)) return;
+		made_macvlan = 1;
+	}
+
+	if (mode != A2065_TAP)
+	{
+		offload_iface = iface;
+		ethernet_offload_off(iface);
+	}
+
+	if (made_macvlan) iface = "xl0";
+	if (!ethernet_open(iface, wired)) return;
+	link_open = 1;
+
+	while (ethernet_recv_nb(frame, MAX_FRAME) > 0);
+	if (wired && mac_known) ethernet_set_mac_filter(guest_mac);
+	printf("[xl1200-enet] bridge up on %s\n", iface);
+}
+
+void xl1200_enet_start()
+{
+	if (!mb)
+	{
+		mb = (volatile uint8_t *)shmem_map(SB_BASE, SB_SIZE);
+		if (!mb)
+		{
+			printf("[xl1200-enet] shmem_map failed\n");
+			return;
+		}
+		wr64(SB_MAGIC, 0);
+	}
+
+	running = 1;
+	gen = ~0ULL;
+	mac_known = 0;
+	cur_mode = A2065_OFF;
+}
+
+void xl1200_enet_stop()
+{
+	if (!running) return;
+	running = 0;
+	close_link();
+}
+
+void xl1200_enet_poll()
+{
+	if (!running || rd64(SB_MAGIC) != XL_MAGIC) return;
+
+	uint64_t g = rd64(SB_GEN);
+	if (g != gen)
+	{
+		gen = g;
+		mac_known = 0;
+	}
+
+	uint64_t m = rd64(SB_MAC);
+	if (m >> 63)
+	{
+		uint8_t mac[6];
+		for (int i = 0; i < 6; i++) mac[i] = m >> (40 - 8 * i);
+		if (!mac_known || memcmp(mac, guest_mac, 6))
+		{
+			memcpy(guest_mac, mac, 6);
+			mac_known = 1;
+			if (link_open && (cur_mode == A2065_ETH0 || cur_mode == A2065_ETH1)) ethernet_set_mac_filter(guest_mac);
+			if (cur_mode == A2065_MACVLAN) cur_mode = -1;
+		}
+	}
+
+	int v = (int)user_io_status_get("[10:8]");
+	int mode = (v == 0) ? A2065_ETH0 : (v == 1) ? A2065_OFF : v;
+	if (mode >= A2065_MODES || !a2065_mode_available(mode)) mode = A2065_OFF;
+
+	if (mode != cur_mode || (mode != A2065_OFF && !link_open))
+	{
+		cur_mode = mode;
+		if (mode == A2065_OFF) close_link();
+		else open_link(mode);
+	}
+
+	uint64_t txw = rd64(SB_TXW);
+	uint64_t txr = rd64(SB_TXR);
+	if (txw - txr > TX_RING) txr = txw;
+	for (; txr != txw; txr++)
+	{
+		uint32_t slot = SB_TX + SB_SLOT * (uint32_t)(txr % TX_RING);
+		int len = rd64(slot) & 0x7FF;
+		if (link_open && len >= 14 && len <= MAX_FRAME)
+		{
+			memcpy(frame, (const void *)(mb + slot + 8), len);
+			ethernet_send(frame, len);
+		}
+	}
+	__sync_synchronize();
+	wr64(SB_TXR, txr);
+
+	if (!link_open) return;
+
+	int len;
+	while ((len = ethernet_recv_nb(frame, MAX_FRAME)) > 0)
+	{
+		uint64_t rxw = rd64(SB_RXW);
+		if (len < 14 || len > MAX_FRAME - 4 || rxw - rd64(SB_RXR) >= RX_RING) continue;
+
+		if (len < 60)
+		{
+			memset(frame + len, 0, 60 - len);
+			len = 60;
+		}
+		uint32_t fcs = crc32_compute(frame, len);
+		for (int k = 0; k < 4; k++) frame[len++] = fcs >> (8 * k);
+		uint32_t hash = ~crc32_compute(frame, 6) >> 26;
+
+		uint32_t slot = SB_RX + SB_SLOT * (uint32_t)(rxw % RX_RING);
+		memcpy((void *)(mb + slot + 8), frame, len);
+		__sync_synchronize();
+		wr64(slot, len | (hash << 16));
+		__sync_synchronize();
+		wr64(SB_RXW, rxw + 1);
+	}
+}
diff --git a/support/xl1200/xl1200.h b/support/xl1200/xl1200.h
new file mode 100644
index 0000000..45a5b83
--- /dev/null
+++ b/support/xl1200/xl1200.h
@@ -0,0 +1,9 @@
+#ifndef XL1200_H
+#define XL1200_H
+
+char is_xl1200();
+void xl1200_enet_start();
+void xl1200_enet_stop();
+void xl1200_enet_poll();
+
+#endif
diff --git a/user_io.cpp b/user_io.cpp
index 9ca34b8..6b86cb0 100644
--- a/user_io.cpp
+++ b/user_io.cpp
@@ -1494,6 +1494,7 @@ void user_io_init(const char *path, const char *xml)
 	sun_enet_stop();
 	hp9k_enet_stop();
 	sgi_enet_stop();
+	xl1200_enet_stop();
 
 	// we need to set the directory to where the XML file (MRA) is
 	// not the RBF. The RBF will be in arcade, which the user shouldn't
@@ -1649,6 +1650,7 @@ void user_io_init(const char *path, const char *xml)
 				if (is_sun_family()) sun_enet_start();
 				if (is_hp9k_family()) hp9k_enet_start();
 				if (is_sgi_family()) sgi_enet_start();
+				if (is_xl1200()) xl1200_enet_start();
 
 				if (xml && isXmlName(xml) == 1)
 				{
@@ -3406,6 +3408,7 @@ void user_io_poll()
 	sun_enet_poll();
 	hp9k_enet_poll();
 	sgi_enet_poll();
+	xl1200_enet_poll();
 
 	// The NeXT keeps a battery backed clock that the guest reads at
 	// boot; the one-shot update at core load is not enough if the core
-- 
