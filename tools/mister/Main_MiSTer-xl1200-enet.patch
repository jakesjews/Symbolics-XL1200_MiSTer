 27 #define SB_BASE       0x1FF00000UL   // shared with the A2065, NeXT and Sun bridges
 28 #define SB_SIZE       0x10000UL
 29 
 30 #define SB_MAGIC_OFF  0x0000   // FPGA, written last; names the RX ring depth
 31 #define SB_GEN_OFF    0x0008   // FPGA, new at every start-up
 32 #define SB_TXW_OFF    0x0010   // FPGA: frames posted
 33 #define SB_TXR_OFF    0x0018   // ours: frames taken
 34 #define SB_RXW_OFF    0x0020   // ours: frames posted
 35 #define SB_RXR_OFF    0x0028   // FPGA: frames taken
 36 #define SB_MAC_OFF    0x0030   // FPGA: bit 63 valid, bits 47:40 the first byte
 37 #define SB_TX_OFF     0x1000   // slot header bits 10:0 = length
 38 #define SB_RX_OFF     0x5000   // slot header bits 10:0 = length with FCS, 21:16 = LADRF index
 39 #define SB_SLOT       0x800
 40 #define SB_TX_RING    8
 41 
 42 #define SB_MAGIC_XL   0x584C455448303031ULL   // XLETH001
 43 
 44 // 0 while the core is not up.
 45 static uint32_t rx_ring_slots(uint64_t magic)
 46 {
 47     return magic == SB_MAGIC_XL ? 16 : 0;
 48 }
 49 
 50 #define MODE_OFF      0
 51 #define MODE_ETH0     1
 52 #define MODE_ETH1     2
 53 #define MODE_MACVLAN  3
 54 #define MODE_TAP      4
 55 
 56 #define MACVLAN_NAME  "xl0"
 57 #define MAX_FRAME     (SB_SLOT - 8)
 58 
 59 static volatile uint8_t *mb = 0;
 60 static int      running = 0;
 61 static int      link_open = 0;
 62 static int      cur_mode = MODE_OFF;
 63 static int      made_macvlan = 0;
 64 static const char *offload_iface = 0;   // offloads we turned off
 65 static uint64_t gen = ~0ULL;
 66 static uint8_t  guest_mac[6];
 67 static int      mac_known = 0;
 68 static uint32_t crc_tab[256];
 69 
 70 static inline uint64_t rd64(uint32_t off) { return *(volatile uint64_t *)(mb + off); }
 71 static inline void wr64(uint32_t off, uint64_t v) { *(volatile uint64_t *)(mb + off) = v; }
 72 
 73 // IEEE 802.3 CRC-32, bit-reversed (as on the wire)
 74 static uint32_t crc32_le(const uint8_t *p, int n)
 75 {
 76     uint32_t c = 0xFFFFFFFF;
 77     while (n--) c = crc_tab[(c ^ *p++) & 0xFF] ^ (c >> 8);
 78     return c;
 79 }
 80 
 81 static int read_guest_mac(uint8_t *out)
 82 {
 83     uint64_t v = rd64(SB_MAC_OFF);
 84     if (!(v >> 63)) return 0;
 85     for (int i = 0; i < 6; i++) out[i] = (v >> (40 - 8 * i)) & 0xFF;
 86     return 1;
 87 }
 88 
 89 static void close_link(void)
 90 {
 91     if (link_open)
 92     {
 93         ethernet_close();
 94         link_open = 0;
 95     }
 96     if (made_macvlan)
 97     {
 98         ethernet_macvlan_delete(MACVLAN_NAME);
 99         made_macvlan = 0;
100     }
101     if (offload_iface)
102     {
103         ethernet_offload_on(offload_iface);
104         offload_iface = 0;
105     }
106 }
107 
108 static void open_link(int mode)
109 {
110     const char *iface;
111     int promisc = 0;
112 
113     close_link();
114     switch (mode)
115     {
116     case MODE_ETH0:
117         iface = "eth0";
118         promisc = 1;   // BPF-filtered on the guest's MAC
119         break;
120     case MODE_ETH1:
121         iface = "eth1";
122         promisc = 1;
123         break;
124     case MODE_MACVLAN:
125         if (!mac_known) return;
126         if (!ethernet_macvlan_create("eth0", MACVLAN_NAME, guest_mac)) return;
127         made_macvlan = 1;
128         iface = MACVLAN_NAME;
129         break;
130     case MODE_TAP:
131         iface = "tap0";
132         break;
133     default:
134         return;
135     }
136 
137     // GRO and friends would hand the guest frames larger than its NIC takes
138     if (mode != MODE_TAP)
139     {
140         offload_iface = (mode == MODE_ETH1) ? "eth1" : "eth0";
141         ethernet_offload_off(offload_iface);
142     }
143 
144     if (!ethernet_open(iface, promisc)) return;
145     link_open = 1;
146 
147     uint8_t scratch[MAX_FRAME];
148     while (ethernet_recv_nb(scratch, MAX_FRAME) > 0) ;
149     if ((mode == MODE_ETH0 || mode == MODE_ETH1) && mac_known) ethernet_set_mac_filter(guest_mac);
150     printf("[xl1200-enet] bridge up on %s (mode %d)\n", iface, mode);
151 }
