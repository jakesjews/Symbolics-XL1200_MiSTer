  1 // Symbolics XL1200 Ethernet bridge: the core's 82586 stays in the FPGA, Main is
  2 // the wire.  Frames cross a DDR3 mailbox of 64-bit little-endian words, the
  3 // Sun cores' protocol (support/sun/sun_enet.cpp) keyed on the magic "XLETH001".
  4 
  5 #include <stdio.h>
  6 #include <string.h>
