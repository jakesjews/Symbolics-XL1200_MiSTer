153 void xl1200_enet_start(void)
154 {
155     if (!mb)
156     {
157         mb = (volatile uint8_t *)shmem_map(SB_BASE, SB_SIZE);
158         if (!mb)
159         {
160             printf("[xl1200-enet] shmem_map failed\n");
161             return;
162         }
163         // a stale magic must not look alive
164         wr64(SB_MAGIC_OFF, 0);
165     }
166     for (uint32_t i = 0; i < 256; i++)
167     {
168         uint32_t c = i;
169         for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320 & -(c & 1));
170         crc_tab[i] = c;
171     }
172     running = 1;
173     gen = ~0ULL;
174     mac_known = 0;
175     cur_mode = MODE_OFF;
176     printf("[xl1200-enet] armed, waiting for the core's mailbox\n");
177 }
178 
179 void xl1200_enet_stop(void)
180 {
181     if (!running) return;
182     running = 0;
183     close_link();
184     printf("[xl1200-enet] stopped\n");
185 }
186 
187 static int mode_from_status(void)
188 {
189     // OSD value 0 is eth0 and 1 is Off; the rest equal their MODE_ value
190     int v = (int)user_io_status_get("[10:8]");
191     int mode = (v == 0) ? MODE_ETH0 : (v == 1) ? MODE_OFF : v;
192     if (mode < 0 || mode > MODE_TAP) mode = MODE_OFF;
193     if (!a2065_mode_available(mode)) mode = MODE_OFF;
194     return mode;
195 }
196 
197 void xl1200_enet_poll(void)
198 {
199     static uint8_t frame[MAX_FRAME + 64];
200 
201     if (!running || !mb) return;
202 
203     uint32_t rx_ring = rx_ring_slots(rd64(SB_MAGIC_OFF));
204     if (!rx_ring) return;
205 
206     // new FPGA start-up: its pointers are zero again
207     uint64_t g = rd64(SB_GEN_OFF);
208     if (g != gen)
209     {
210         gen = g;
211         mac_known = 0;
212         printf("[xl1200-enet] core mailbox up (generation %08llX)\n", (unsigned long long)g);
213     }
214 
215     uint8_t m[6];
216     if (read_guest_mac(m) && (!mac_known || memcmp(m, guest_mac, 6)))
217     {
218         memcpy(guest_mac, m, 6);
219         mac_known = 1;
220         printf("[xl1200-enet] guest MAC %02X:%02X:%02X:%02X:%02X:%02X\n",
221                m[0], m[1], m[2], m[3], m[4], m[5]);
222         if (link_open && (cur_mode == MODE_ETH0 || cur_mode == MODE_ETH1))
223             ethernet_set_mac_filter(guest_mac);
224         if (cur_mode == MODE_MACVLAN) cur_mode = -1;   // recreate the child
225     }
226 
227     int mode = mode_from_status();
228     if (mode != cur_mode)
229     {
230         cur_mode = mode;
231         if (mode == MODE_OFF) close_link();
232         else open_link(mode);
233     }
234     else if (mode != MODE_OFF && !link_open)
235     {
236         open_link(mode);
237     }
238 
239     // TX: guest to host
240     uint64_t txw = rd64(SB_TXW_OFF);
241     uint64_t txr = rd64(SB_TXR_OFF);
242     if (txw - txr > SB_TX_RING) txr = txw;           // out of step: resync
243     while (txr != txw)
244     {
245         uint32_t slot = SB_TX_OFF + SB_SLOT * (uint32_t)(txr % SB_TX_RING);
246         int len = (int)(rd64(slot) & 0x7FF);
247         if (link_open && len >= 14 && len <= MAX_FRAME)
248         {
249             memcpy(frame, (const void *)(mb + slot + 8), len);
250             ethernet_send(frame, len);
251         }
252         txr++;
253     }
254     __sync_synchronize();
255     wr64(SB_TXR_OFF, txr);
256 
257     if (!link_open) return;
258 
259     // RX: host to guest
260     for (;;)
261     {
262         int len = ethernet_recv_nb(frame, MAX_FRAME);
263         if (len <= 0) break;
264         if (len < 14) continue;
265 
266         uint64_t rxw = rd64(SB_RXW_OFF);
267         uint64_t rxr = rd64(SB_RXR_OFF);
268         if (rxw - rxr >= rx_ring) continue;          // full: drop, keep draining
269 
270         if (len < 60)
271         {
272             memset(frame + len, 0, 60 - len);
273             len = 60;
274         }
275         if (len > MAX_FRAME - 4) continue;
276         uint32_t fcs = ~crc32_le(frame, len);
277         for (int k = 0; k < 4; k++) frame[len++] = fcs >> (8 * k);
278         uint32_t hash = crc32_le(frame, 6) >> 26;
279 
280         uint32_t slot = SB_RX_OFF + SB_SLOT * (uint32_t)(rxw % rx_ring);
281         memcpy((void *)(mb + slot + 8), frame, len);
282         __sync_synchronize();
283         wr64(slot, (uint64_t)len | ((uint64_t)hash << 16));
284         __sync_synchronize();
285         wr64(SB_RXW_OFF, rxw + 1);
286     }
287 }
288 
289 char is_xl1200()
290 {
291     return !strncasecmp(user_io_get_core_name(0), "XL1200", 6)
292         || !strncasecmp(user_io_get_core_name(1), "XL1200", 6);
293 }
