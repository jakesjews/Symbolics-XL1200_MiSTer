 15 // host network layer, from the A2065 module
 16 extern int  ethernet_open(const char *iface, int promiscuous);
 17 extern void ethernet_close(void);
 18 extern void ethernet_send(const uint8_t *frame, int len);
 19 extern int  ethernet_recv_nb(uint8_t *buf, int maxlen);
 20 extern int  ethernet_set_mac_filter(const uint8_t *mac);
 21 extern int  ethernet_macvlan_create(const char *parent, const char *name, const uint8_t *mac);
 22 extern void ethernet_macvlan_delete(const char *name);
 23 extern int  a2065_mode_available(int mode);
 24 extern void ethernet_offload_off(const char *iface);
 25 extern void ethernet_offload_on(const char *iface);
