+
+/* Modern X.Org servers reject a SetModifierMapping request that lists the same keycode
+   under more than one modifier (BadValue).  The stock Genera 8.5 X console code
+   (X-SCREEN::UPDATE-SERVER-MODIFIER-MAPPING) builds exactly such a request while holding a
+   server grab; the resulting error puts Genera into the debugger on the cold load stream,
+   which cannot be drawn while the server is grabbed, so the whole X server hangs.
+   We watch the server->Lisp byte stream and turn that one error into a MappingSuccess
+   reply, so Genera simply keeps the server's existing modifier map.
+   (Set VLM_NO_MODMAP_FIXUP=1 in the environment to disable.) */
+
+static unsigned char fixupHeader[32];
+static int fixupHeaderFill = 0;
+static size_t fixupBodySkip = 0;
+static int fixupDisabled = -1;
+
+static void ResetConsoleInputFixup (void)
+{
+	fixupHeaderFill = 0;
+	fixupBodySkip = 0;
+}
+
+static void FixupConsoleInput (unsigned char* data, ssize_t n)
+{
+	if (fixupDisabled < 0)
+		fixupDisabled = (getenv ("VLM_NO_MODMAP_FIXUP") != NULL);
+	while (n > 0)
+	  {
+		if (fixupBodySkip)
+		  {
+			size_t k = (fixupBodySkip < (size_t)n) ? fixupBodySkip : (size_t)n;
+			fixupBodySkip -= k; data += k; n -= k;
+			continue;
+		  }
+		{
+			int k = 32 - fixupHeaderFill;
+			int whole = (0 == fixupHeaderFill) && (n >= 32);
+			if (k > n) k = n;
+			memcpy (&fixupHeader[fixupHeaderFill], data, k);
+			fixupHeaderFill += k; data += k; n -= k;
+			if (fixupHeaderFill < 32) break;
+			fixupHeaderFill = 0;
+			if ((1 == fixupHeader[0]) || (35 == (fixupHeader[0] & 0x7F)))
+				/* Reply or GenericEvent: 32 bytes + 4*length (client byte order is LSB first) */
+				fixupBodySkip = 4 * ((size_t)fixupHeader[4] | ((size_t)fixupHeader[5] << 8) |
+						     ((size_t)fixupHeader[6] << 16) | ((size_t)fixupHeader[7] << 24));
+			else if ((0 == fixupHeader[0]) && (2 == fixupHeader[1]) && (118 == fixupHeader[10])
+				 && whole && !fixupDisabled)
+			  {
+				unsigned char* msg = data - 32;
+				unsigned char seqLo = msg[2], seqHi = msg[3];
+				memset (msg, 0, 32);
+				msg[0] = 1;			/* Reply */
+				msg[1] = 0;			/* MappingSuccess */
+				msg[2] = seqLo; msg[3] = seqHi;	/* Same sequence number, length 0 */
+				vwarn ("console", "X server rejected Genera's SetModifierMapping (BadValue); "
+				       "keeping the existing modifier map");
+			  }
+		}
+	  }
+}
+
 /* Write data to the server */
 
 int ConsoleWrite (EmbConsoleChannel* pConsoleChannel, EmbConsoleBuffer* pCommand)
@@ -544,6 +608,8 @@ int ConsoleRead (EmbConsoleChannel* pConsoleChannel, EmbConsoleBuffer* pCommand)
 		if (pollDisplay.revents & POLLIN)
 		  {
