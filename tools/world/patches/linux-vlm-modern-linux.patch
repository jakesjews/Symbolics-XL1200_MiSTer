+			if (actualBytes > 0)
+				FixupConsoleInput ((unsigned char*) data, actualBytes);
 			if (actualBytes == nBytes)
 				result = ESUCCESS;
 			else if ((0 == actualBytes) && (EWOULDBLOCK != errno))
