# Standalone synthesis of the Ivory processor, to check resources and timing.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY ivory_cpu
set_global_assignment -name SEARCH_PATH ../../rtl/ivory
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ivory/ivory_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ivory/ivory_cpu.sv
set_global_assignment -name SDC_FILE ivory_cpu.sdc
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# Every port but the clock is a virtual pin
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to mem_*
set_instance_assignment -name VIRTUAL_PIN ON -to cop_*
set_instance_assignment -name VIRTUAL_PIN ON -to hp_sb
set_instance_assignment -name VIRTUAL_PIN ON -to lp_sb
set_instance_assignment -name VIRTUAL_PIN ON -to reset_req
set_instance_assignment -name VIRTUAL_PIN ON -to hp_sb_taken
set_instance_assignment -name VIRTUAL_PIN ON -to lp_sb_taken
set_instance_assignment -name VIRTUAL_PIN ON -to usec_clock[*]
set_instance_assignment -name VIRTUAL_PIN ON -to retire
set_instance_assignment -name VIRTUAL_PIN ON -to retire_counted
set_instance_assignment -name VIRTUAL_PIN ON -to halted
